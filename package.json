{
  "name": "dsh-subagent",
  "version": "0.1.1",
  "description": "Aggregate external subscription CLIs (Qoder, QoderCN, and more) as dsh subagent providers, delegating tasks through dsh-tool-subagent",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh-subagent",
    "deepseek-harness",
    "subagent",
    "qoder",
    "qodercli",
    "qodercn",
    "subscription"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
