{
  "name": "dsh-subagent",
  "version": "0.4.6",
  "description": "Aggregate external subscription CLIs (Qoder, QoderCN, and more) as dsh subagent providers, with a settings page for model/effort/context control",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "src/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-subagent",
    "deepseek-harness",
    "subagent",
    "qoder",
    "qodercli",
    "qodercn",
    "subscription"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.14.0",
    "react": "^18.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
